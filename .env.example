# Local development default: http://localhost:1337
# Production default: https://api.tryliner.fun (or custom instance)
VITE_API_URL=http://localhost:1337
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun

LINER_DEV_SIGNING_SECRET=

# --- Web / iOS server ---
# Port the API + static web server listens on
PORT=8787
# Upstream Liner API that the server signs requests for
LINER_API_ORIGIN=https://api.tryliner.fun
# Optional shared secret. When set, clients must send x-nyx-token.
NYX_API_TOKEN=

# --- iOS build (GitHub Actions secrets) ---
# Public HTTPS URL of the deployed web app, e.g. https://nyx.example.com
NYX_SERVER_URL=
# Public HTTPS URL of the API proxy, e.g. https://nyx.example.com/api/liner
NYX_API_URL=
