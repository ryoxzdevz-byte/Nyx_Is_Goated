{
  "name": "nyx-client",
  "version": "0.2.34",
  "author": {
    "name": "Nyx local build"
  },
  "license": "Liner-Source-1.0",
  "private": true,
  "description": "Nyx - local private build based on Liner",
  "productName": "Nyx",
  "desktopName": "nyx",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build": "tsc -b && vite build && electron-builder --publish never",
    "electron:build:linux": "tsc -b && vite build && electron-builder --linux --publish never",
    "electron:build:win": "pnpm native:build && tsc -b && vite build && electron-builder --win --publish never",
    "electron:build:mac": "tsc -b && vite build && electron-builder --mac --publish never",
    "native:build": "node scripts/build-native-addon.cjs"
  },
  "build": {
    "appId": "com.nyx.player",
    "productName": "Nyx",
    "executableName": "nyx",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Nyx",
        "schemes": [
          "nyx"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "native/snap-preview/build/Release/snap_preview.node"
    ],
    "linux": {
      "executableName": "nyx",
      "syncDesktopName": true,
      "maintainer": "Nyx local build",
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    },
    "deb": {
      "packageName": "nyx",
      "artifactName": "nyx_${version}_${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Nyx-${version}.${ext}"
    },
    "win": {
      "executableName": "nyx",
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Nyx-Setup-${version}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "asarUnpack": [
      "native/**/*.node"
    ]
  },
  "dependencies": {
    "@braccato/core": "^1.16.13",
    "@braccato/parsers": "^0.4.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@mingcute/react": "^1.4.1",
    "@solar-icons/react": "^1.1.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@xhayper/discord-rpc": "^1.5.1",
    "bgutils-js": "4.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "googlevideo": "5.0.1",
    "gsap": "^3.15.0",
    "hash-wasm": "4.12.0",
    "lottie-web": "^5.13.0",
    "meriyah": "7.4.0",
    "morphicons": "^1.7.1",
    "music-metadata": "^11.16.1",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-apple-emojis": "^3.0.0",
    "react-dom": "19.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.4",
    "solar-icons": "^0.0.15",
    "soundtouchjs": "^0.3.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "youtubei.js": "18.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.29.1",
      "js-yaml": "^4.3.2"
    }
  }
}
